# Copy these keys into your production secret manager.
# Do not commit real values.

# Database
DATABASE_URL=
DIRECT_URL=

# Auth
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Storage
PUBLIC_STORAGE_BASE_URL=/api/storage
STORAGE_ROOT_PATH=

# Rate Limiting (shared across instances)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
